# Copy to .env and replace the API key placeholder. Never commit real credentials.
# Groq was used by the team; its connection settings below are commented references.
# For campus Qwen, follow the marker setup section in README.md and use your own key.

LLM_PROVIDER=mock
LLM_FALLBACK_TO_MOCK=true
LLM_TIMEOUT_S=45
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true
COMPLIANCE_SAFETY_THRESHOLD=0.95
MAX_CORRECTIONS=3
PRICE_MAX_AGE_HOURS=24
REVIEW_SLA_MINUTES=60
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_API_KEY=your-api-key-here

# Optional overrides (uncomment only when needed).
# These settings still use their application defaults when absent from .env.
# LLM_MAX_OUTPUT_TOKENS=768
# DEMO_PRICE_HISTORY=true
# TOKEN_TTL_HOURS=8
# SESSION_IDLE_MINUTES=30
# MAX_ACTIVE_SESSIONS=3
# API_REQUESTS_PER_MINUTE=300
# ACCOUNT_WRITES_PER_MINUTE=30
# AUTH_ATTEMPTS_PER_MINUTE=10
# ACCOUNT_LOGIN_ATTEMPTS_PER_QUARTER_HOUR=10
# REGISTRATIONS_PER_HOUR=5
# TRACING_ENABLED=false
# TRACING_ENDPOINT=http://127.0.0.1:4318/v1/traces
# TRACING_SAMPLE_RATIO=1.0

# The observability Compose override enables tracing and sets the container endpoint.
# For offline use, set LLM_PROVIDER=mock; no API key is required.
