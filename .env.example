# Copy to `.env` (same folder) and fill in. `.env` is git-ignored — never commit real keys.
# Everything has a working default: with no .env at all the app runs offline on the mock LLM.

# ---------------------------------------------------------------------------
# LLM provider: mock | openai_compatible | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# --- Option A: ELEC5620 Campus Qwen proxy (OpenAI-compatible; needs uni VPN) ---
# Get the base URL, model name and key from the "ELEC5620 Proxy Connection Guide" (Lab 9).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<campus-proxy-host>/v1
# LLM_MODEL=<qwen-model-name-from-the-guide>
# LLM_API_KEY=<your-proxy-key>

# --- Option B: Groq (OpenAI-compatible) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<model-available-to-your-account>
# LLM_API_KEY=<your-groq-key>

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model-available-to-your-account>
# LLM_API_KEY=sk-...

# --- Option D: local model via Ollama (works offline after downloading a model) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<downloaded-model-name>

# --- Option E: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=<model-available-to-your-account>
# ANTHROPIC_EFFORT=low

# If the provider fails, use labelled offline responses for supported tasks.
# Fallback cannot clear an uncertain ingredient that requires a live assessment;
# it stays withheld for review. See docs/COMPLIANCE_VERDICT.md.
LLM_FALLBACK_TO_MOCK=true
LLM_TIMEOUT_S=45
# Bound output reservations on free-tier APIs. Truncated replies fail safely.
LLM_MAX_OUTPUT_TOKENS=768
# Optional provider-specific override; Groq qwen/qwen3.8-27b defaults to none.
# LLM_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Keys hashed rate-limit identifiers. Leave unset to generate a random key in
# backend/.secret_key. Share it across workers using the same database.
# SECRET_KEY=
# DATABASE_URL=sqlite:///./trolleymate.db     # default lives in backend/
# SQLite is the installed/tested database. Other engines need a driver and validation.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# Policy knobs owned by the AI Technical Manager
COMPLIANCE_SAFETY_THRESHOLD=0.95
MAX_CORRECTIONS=3
PRICE_MAX_AGE_HOURS=24
# true while price history is the generated demo data: buy-timing advice is labelled, never a forecast
DEMO_PRICE_HISTORY=true
REVIEW_SLA_MINUTES=60

# Authentication and request security (server enforced)
TOKEN_TTL_HOURS=8
SESSION_IDLE_MINUTES=30
MAX_ACTIVE_SESSIONS=3
API_REQUESTS_PER_MINUTE=300
ACCOUNT_WRITES_PER_MINUTE=30
AUTH_ATTEMPTS_PER_MINUTE=10
ACCOUNT_LOGIN_ATTEMPTS_PER_QUARTER_HOUR=10
REGISTRATIONS_PER_HOUR=5
