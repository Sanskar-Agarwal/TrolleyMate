{
  "_comment": "Deterministic small-catalogue optimiser fixtures (P01, 1.2.2/1.2.4 interfaces). See docs/OPTIMISER_CONTRACT.md. Every role need is <= 4, so variety caps are inactive and each pack's upper bound is 1: the answers can be checked by hand. nutrition is per pack. expect.items maps sku -> packs; min_budget is the uncapped Lowest Cost total under the goal's own requirements, rounded up to the cent.",
  "retailer": {"id": 1, "name": "Spike Mart"},
  "products": [
    {"id": 1, "sku": "SPK-CHICKEN", "name": "Chicken thigh 500 g", "category": "protein", "servings": 2, "price": 6.00,
     "nutrition": {"kcal": 600, "protein_g": 50, "veg_serves": 0, "fibre_g": 0}, "substitution_group": "poultry", "perishable": true, "prep_minutes_per_serving": 15},
    {"id": 2, "sku": "SPK-LENTIL", "name": "Brown lentils 400 g", "category": "protein", "servings": 2, "price": 2.00,
     "nutrition": {"kcal": 400, "protein_g": 18, "veg_serves": 0, "fibre_g": 12}, "substitution_group": "legumes", "perishable": false, "prep_minutes_per_serving": 5},
    {"id": 3, "sku": "SPK-RICE", "name": "Long-grain rice 500 g", "category": "carb", "servings": 4, "price": 3.50,
     "nutrition": {"kcal": 1400, "protein_g": 25, "veg_serves": 0, "fibre_g": 3}, "substitution_group": "rice", "perishable": false, "prep_minutes_per_serving": 12},
    {"id": 4, "sku": "SPK-PASTA", "name": "Penne 500 g", "category": "carb", "servings": 4, "price": 2.00,
     "nutrition": {"kcal": 1400, "protein_g": 20, "veg_serves": 0, "fibre_g": 6}, "substitution_group": "pasta", "perishable": false, "prep_minutes_per_serving": 10},
    {"id": 5, "sku": "SPK-BROCCOLI", "name": "Broccoli 500 g", "category": "veg", "servings": 4, "price": 3.00,
     "nutrition": {"kcal": 120, "protein_g": 10, "veg_serves": 4, "fibre_g": 9}, "substitution_group": "brassica", "perishable": true, "prep_minutes_per_serving": 5},
    {"id": 6, "sku": "SPK-CARROT", "name": "Carrots 500 g", "category": "veg", "servings": 4, "price": 2.00,
     "nutrition": {"kcal": 100, "protein_g": 3, "veg_serves": 4, "fibre_g": 8}, "substitution_group": "root", "perishable": true, "prep_minutes_per_serving": 5}
  ],
  "requirements": {
    "household_size": 1, "days": 1, "meals_per_day": 2, "person_meals": 2, "main_meals": 2, "breakfast_meals": 0,
    "kcal": 1100, "protein_g": 44, "veg_serves": 4, "protein_servings": 2, "carb_servings": 2, "breakfast_servings": 0
  },
  "cases": [
    {"id": "feasible_lowest_cost", "goal": "lowest_cost", "budget": 10.00,
     "_why": "lentils+pasta+carrots ($6) has only 41 g protein; the unique cheapest basket that reaches 44 g swaps carrots for broccoli.",
     "expect": {"feasible": true, "timed_out": false, "total": 7.00, "items": {"SPK-LENTIL": 1, "SPK-PASTA": 1, "SPK-BROCCOLI": 1}}},
    {"id": "infeasible_budget", "goal": "lowest_cost", "budget": 5.00,
     "expect": {"feasible": false, "timed_out": false, "min_budget": 7.00, "shortfall": 2.00}},
    {"id": "infeasible_budget_best_nutrition", "goal": "best_nutrition", "budget": 8.00,
     "_why": "Best Nutrition raises veg to 6.4 serves and protein to 48.4 g, so both vegetables are needed: the goal's own bar costs $9.00.",
     "expect": {"feasible": false, "timed_out": false, "min_budget": 9.00, "shortfall": 1.00}},
    {"id": "infeasible_no_protein", "goal": "lowest_cost", "budget": 50.00, "exclude": ["SPK-CHICKEN", "SPK-LENTIL"],
     "expect": {"feasible": false, "timed_out": false}},
    {"id": "every_goal_feasible", "goal": "*", "budget": 20.00,
     "expect": {"feasible": true, "timed_out": false}}
  ]
}
