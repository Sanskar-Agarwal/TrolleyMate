# Copy to `.env` (same folder) and fill in. `.env` is git-ignored — never commit real keys.
# Everything has a working default: with no .env at all the app runs offline on the mock LLM.

# ---------------------------------------------------------------------------
# LLM provider: mock | openai_compatible | anthropic
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# --- Option A: ELEC5620 Campus Qwen proxy (OpenAI-compatible; needs uni VPN) ---
# Get the base URL, model name and key from the "ELEC5620 Proxy Connection Guide" (Lab 9).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://<campus-proxy-host>/v1
# LLM_MODEL=<qwen-model-name-from-the-guide>
# LLM_API_KEY=<your-proxy-key>

# --- Option B: OpenAI ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Option C: local model via Ollama (no key, works offline; `ollama pull qwen2.5:7b`) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# --- Option D: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# If the provider fails (network, bad key, bad JSON), answer with the offline mock instead
# of erroring. Keep this on for the live demo.
LLM_FALLBACK_TO_MOCK=true
LLM_TIMEOUT_S=45

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL=sqlite:///./trolleymate.db     # default lives in backend/
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/trolleymate
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# Policy knobs owned by the AI Technical Manager
COMPLIANCE_SAFETY_THRESHOLD=0.95
MAX_CORRECTIONS=3
PRICE_MAX_AGE_HOURS=24
REVIEW_SLA_MINUTES=60
